# 4) Combined radar (top 5 solutions) - normalized and inverting latency/response_time so larger = better
from math import pi
def plot_combined_radar(df, top_k=5):
    labels = ['Accuracy','Precision','Recall','F1','TPR','Reliability','Availability','Throughput','Latency_inv','ResponseTime_inv']
    sub = df.copy().head(top_k).reset_index(drop=True)

    # Prepare values and normalize each axis 0-1
    vals = pd.DataFrame()
    # Latency_inv and ResponseTime_inv are inverted so higher is better
    vals['Accuracy'] = sub['Accuracy']
    vals['Precision'] = sub['Precision']
    vals['Recall'] = sub['Recall']
    vals['F1'] = sub['F1']
    vals['TPR'] = sub['TPR']
    vals['Reliability'] = sub['Reliability']
    vals['Availability'] = sub['Availability']
    vals['Throughput'] = sub['Throughput']
    vals['Latency_inv'] = sub['Latency'].max() - sub['Latency']  # bigger = better
    vals['ResponseTime_inv'] = sub['ResponseTime_ms'].max() - sub['ResponseTime_ms']

    # Normalize each column 0-1
    for c in vals.columns:
        rng = vals[c].max() - vals[c].min()
        if rng == 0:
            vals[c] = 0.5
        else:
            vals[c] = (vals[c] - vals[c].min()) / rng

    angles = [n / float(len(labels)) * 2 * pi for n in range(len(labels))]
    angles += angles[:1]

    fig, ax = plt.subplots(figsize=(8,8), subplot_kw=dict(polar=True))
    for i in range(len(vals)):
        data = vals.loc[i].tolist()
        data += data[:1]
        ax.plot(angles, data, linewidth=1, label=f'Sol #{i+1}')
        ax.fill(angles, data, alpha=0.1)
    ax.set_xticks(angles[:-1])
    ax.set_xticklabels(labels, fontsize=9)
    ax.set_yticks([])
    plt.legend(loc='upper right', bbox_to_anchor=(1.3, 1.1))
    plt.title(f"Combined radar (top {len(vals)})")
    plt.show()

plot_combined_radar(df_pareto_sorted, top_k=5)

