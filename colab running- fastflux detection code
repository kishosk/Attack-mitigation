import re
import pandas as pd

file_path = "merged_fastflux_dataset[1].txt"

# Step 1: Read the raw file
with open(file_path, 'r') as f:
    lines = f.readlines()

# Step 2: Filter only lines with actual DNS A record answers
# Example: "example.com.  300 IN  A  93.184.216.34"
data_lines = []
for line in lines:
    # Match lines containing: domain, TTL, 'IN', 'A', and IP
    match = re.match(r"^(\S+)\s+(\d+)\s+IN\s+A\s+(\d+\.\d+\.\d+\.\d+)", line)
    if match:
        domain = match.group(1)
        ttl = int(match.group(2))
        ip = match.group(3)
        data_lines.append([domain, ttl, ip])

# Step 3: Convert to DataFrame
df = pd.DataFrame(data_lines, columns=["domain", "ttl", "ip"])
print(f"[+] Extracted {len(df)} DNS A records")
print(df.head())

# Step 4: Fast Flux Detection thresholds
LOW_TTL_THRESHOLD = 600
IP_CHANGE_THRESHOLD = 5

# Step 5: Group by domain to detect suspicious patterns
suspicious_domains = []
for domain, group in df.groupby("domain"):
    unique_ips = group["ip"].nunique()
    avg_ttl = group["ttl"].mean()

    if unique_ips >= IP_CHANGE_THRESHOLD and avg_ttl <= LOW_TTL_THRESHOLD:
        suspicious_domains.append({
            "domain": domain,
            "unique_ips": unique_ips,
            "avg_ttl": avg_ttl
        })
